#!/usr/bin/env bash
#
# remove-microsoft-autoupdate - remove Microsoft AutoUpdate from macOS
#
# Stops the MAU launch agent/daemon, deletes the app, helper tool and
# preferences, and forgets the installer receipt so Office doesn't think
# it's still installed.

set -u

VERSION="1.0.0"
PROG=${0##*/}

dry_run=0
assume_yes=0

usage() {
    cat <<EOF
Usage: sudo $PROG [options]

Remove Microsoft AutoUpdate (MAU) and its launch agents, helper tool
and preferences.

Options:
  -n, --dry-run   list what would be removed, change nothing
  -y, --yes       don't ask for confirmation
  -h, --help      show this help
  -V, --version   show version
EOF
}

die() {
    echo "$PROG: $*" >&2
    exit 1
}

confirm() {
    [ "$assume_yes" -eq 1 ] && return 0
    local reply
    read -r -p "$1 [y/N] " reply
    [[ $reply =~ ^[Yy]([Ee][Ss])?$ ]]
}

size_of() {
    du -sh "$1" 2>/dev/null | cut -f1
}

while [ $# -gt 0 ]; do
    case $1 in
        -n|--dry-run) dry_run=1 ;;
        -y|--yes)     assume_yes=1 ;;
        -h|--help)    usage; exit 0 ;;
        -V|--version) echo "$PROG $VERSION"; exit 0 ;;
        *)            usage >&2; exit 2 ;;
    esac
    shift
done

[ "$(uname -s)" = Darwin ] || die "this only works on macOS"

if [ "$dry_run" -eq 0 ] && [ "$(id -u)" -ne 0 ]; then
    die "must be run as root (try: sudo $0)"
fi

# When run through sudo we still want to clean the real user's ~/Library,
# not root's.
user=${SUDO_USER:-$(stat -f %Su /dev/console)}
user_home=""
user_uid=""
if [ -n "$user" ] && [ "$user" != root ]; then
    user_home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    user_uid=$(id -u "$user" 2>/dev/null)
fi

targets=(
    "/Library/Application Support/Microsoft/MAU2.0"
    "/Library/LaunchAgents/com.microsoft.update.agent.plist"
    "/Library/LaunchDaemons/com.microsoft.autoupdate.helper.plist"
    "/Library/PrivilegedHelperTools/com.microsoft.autoupdate.helper"
    "/Library/Preferences/com.microsoft.autoupdate2.plist"
    "/Library/Caches/com.microsoft.autoupdate.helper"
)

if [ -n "$user_home" ]; then
    targets+=(
        "$user_home/Library/Preferences/com.microsoft.autoupdate2.plist"
        "$user_home/Library/Preferences/com.microsoft.autoupdate.fba.plist"
        "$user_home/Library/Caches/com.microsoft.autoupdate2"
        "$user_home/Library/Caches/com.microsoft.autoupdate.fba"
        "$user_home/Library/HTTPStorages/com.microsoft.autoupdate2"
        "$user_home/Library/Application Support/Microsoft AU Daemon"
    )
fi

found=()
echo "Microsoft AutoUpdate components:"
echo
for t in "${targets[@]}"; do
    if [ -e "$t" ]; then
        printf '  %-8s %6s  %s\n' found "$(size_of "$t")" "$t"
        found+=("$t")
    else
        printf '  %-8s %6s  %s\n' missing - "$t"
    fi
done
echo

receipts=$(pkgutil --pkgs 2>/dev/null | grep '^com\.microsoft\.package\.Microsoft_AutoUpdate')
if [ -n "$receipts" ]; then
    echo "Installer receipts:"
    echo "$receipts" | sed 's/^/  /'
    echo
fi

if [ ${#found[@]} -eq 0 ] && [ -z "$receipts" ]; then
    echo "Nothing to remove."
    exit 0
fi

if [ "$dry_run" -eq 1 ]; then
    echo "Dry run, nothing was changed."
    exit 0
fi

confirm "Remove ${#found[@]} item(s)?" || { echo "Aborted."; exit 1; }
echo

# Stop everything first, otherwise the helper can recreate files
# while we're deleting them.
launchctl bootout system/com.microsoft.autoupdate.helper 2>/dev/null
if [ -n "$user_uid" ]; then
    launchctl bootout "gui/$user_uid/com.microsoft.update.agent" 2>/dev/null
fi
pkill -x "Microsoft AutoUpdate" 2>/dev/null
pkill -x "Microsoft Update Assistant" 2>/dev/null

failed=0
for t in "${found[@]}"; do
    rm -rf "$t" 2>/dev/null
    if [ -e "$t" ]; then
        echo "  failed   $t"
        failed=$((failed + 1))
    else
        echo "  removed  $t"
    fi
done

for r in $receipts; do
    pkgutil --forget "$r" >/dev/null 2>&1 && echo "  forgot   $r"
done

echo
if [ "$failed" -gt 0 ]; then
    echo "$failed item(s) could not be removed."
    exit 1
fi

echo "Done. Office apps will no longer update themselves; download updates from"
echo "https://learn.microsoft.com/officeupdates/update-history-office-for-mac"
